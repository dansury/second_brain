# =============================================================================
# base-image.env — закреплённая (pinned) версия базового образа hermes-agent
# =============================================================================
# ЕДИНСТВЕННЫЙ источник правды о том, на какой версии hermes собирается образ.
# Строка FROM в Dockerfile синхронизируется отсюда командой:
#
#     scripts/hermes-update.sh sync
#
# CI (.github/workflows/build.yml, job verify-pin) падает, если Dockerfile и
# этот файл разошлись — так пин нельзя обойти случайной правкой Dockerfile.
#
# Зачем пин: раньше было `FROM nousresearch/hermes-agent:latest`. Тег latest в
# этом репозитории указывает на main (см. tags: latest и main имеют один
# digest), поэтому любая пересборка на amvera молча подтягивала произвольную
# версию ядра — без возможности узнать, что изменилось, и без отката.
#
# Как обновляться:
#   scripts/hermes-update.sh check      # есть ли новая версия
#   scripts/hermes-update.sh update     # закрепить новую (старая → PREVIOUS)
#   scripts/hermes-update.sh rollback   # вернуть PREVIOUS
# Автоматически это делает .github/workflows/hermes-update.yml (раз в сутки:
# проверка → сборка → PR). Мердж PR = обновление, revert PR = откат.
# =============================================================================

# --- Репозиторий базового образа --------------------------------------------
HERMES_IMAGE_REPO=nousresearch/hermes-agent

# --- Канал обновлений --------------------------------------------------------
# release — только теги вида vГОД.МЕСЯЦ.ДЕНЬ (стабильные релизы). Рекомендуется.
# latest  — тег latest (= ветка main апстрима, ломается чаще).
HERMES_UPDATE_CHANNEL=release

# --- Текущий пин -------------------------------------------------------------
# Образ собирается ровно из этого digest. Тег хранится только для читаемости:
# сборка идёт по digest, поэтому она воспроизводима даже если тег переставят.
HERMES_IMAGE_TAG=v2026.8.19
HERMES_IMAGE_DIGEST=sha256:3811ed13da874fba2ac99b6d492db9a203d34cb6dccf90d886948c00d0ccec09
HERMES_PINNED_AT=2026-08-21T00:00:00Z

# --- Предыдущий пин (цель для `rollback`) ------------------------------------
# Здесь зафиксировано то, на чём репозиторий работал до введения пина:
# плавающий тег latest на момент 2026-08-21. Один `rollback` возвращает его.
HERMES_PREVIOUS_TAG=latest
HERMES_PREVIOUS_DIGEST=sha256:5024b4938740ad1c78fd0fb0ddaac643f8601dcedde6b543131c083e6b02d4ff
