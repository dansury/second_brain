# =============================================================================
# second_brain — конфигурация окружения
# =============================================================================
# Скопируйте этот файл в `.env` и заполните значения:
#     cp env.example .env
#
# На amvera.ru переменные задаются в разделе "Переменные" (Secrets) сервиса,
# а НЕ коммитятся в репозиторий. `.env` добавлен в .gitignore.
#
# Стек:
#   • hermes-agent  — ядро агента и Telegram-бот (LLM через OpenRouter)
#   • gbrain        — долговременная память (эмбеддинги через Yandex Cloud)
#   • Grafify       — граф знаний по коду (MCP-инструмент, опционально)
#   • secondbrain   — дневник-консультант: Obsidian-хранилище, персоны,
#                     линт, feedback, прайсинг моделей (см. ТЗ.md)
# =============================================================================


# =============================================================================
# 1. TELEGRAM  (обязательно)
# =============================================================================
# Токен бота от @BotFather — https://t.me/BotFather
TELEGRAM_BOT_TOKEN=

# Разрешённые пользователи (ID через запятую). Узнать свой ID: @userinfobot.
# ПУСТО = бот отвечает всем (небезопасно). Всегда указывайте свой ID.
TELEGRAM_ALLOWED_USERS=

# Чат по умолчанию для доставки напоминаний/крона (обычно ваш личный чат = ваш ID)
TELEGRAM_HOME_CHANNEL=

# --- Режим webhook (опционально; по умолчанию long polling — публичный URL не нужен) ---
# amvera выдаёт домен вида https://<app>-<user>.amvera.io — его и подставьте.
# TELEGRAM_WEBHOOK_URL=https://your-app.amvera.io/telegram
# TELEGRAM_WEBHOOK_PORT=8080
# TELEGRAM_WEBHOOK_SECRET=


# =============================================================================
# 2. OPENROUTER — LLM-«мозг» агента  (обязательно)
# =============================================================================
# Ключ: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Модель по умолчанию (любая модель из каталога OpenRouter).
# Примеры: anthropic/claude-opus-4.6, openai/gpt-5, google/gemini-3-flash-preview
LLM_MODEL=anthropic/claude-opus-4.6

# Провайдер вывода для hermes. Оставьте openrouter, чтобы все вызовы шли через OpenRouter.
LLM_PROVIDER=openrouter

# --- Вторичная LLM-роль: суммаризатор авто-сжатия длинного диалога -----------
# Отдельная (обычно более дешёвая/быстрая) модель. Если пусто — используется
# дефолт hermes. Провайдер задаётся отдельно.
LLM_SUMMARY_MODEL=google/gemini-3-flash-preview
LLM_SUMMARY_PROVIDER=openrouter

# ⓘ Выбор провайдера и модели «на лету» для основного агента делается прямо в
#   Telegram командой /model (интерактивный список моделей провайдера):
#     /model                          — открыть список/пикер
#     /model <название>               — переключить модель
#     /model --provider yandex        — переключиться на YandexGPT
#     /model --provider openrouter    — вернуться на OpenRouter
#     /model <название> --provider <провайдер>
#   Провайдер «yandex» появляется в /model автоматически, когда заданы
#   YANDEX_CLOUD_API_KEY и YANDEX_CLOUD_FOLDER_ID (блок 3).
#   Вторичные роли (суммаризатор, зрение) задаются переменными выше/в config.yaml.


# =============================================================================
# 3. YANDEX CLOUD — эмбеддинги для памяти gbrain  (обязательно для памяти)
# =============================================================================
# gbrain обращается к Yandex Cloud через OpenAI-совместимый эндпоинт AI Studio.
# Документация: https://yandex.cloud/ru/docs/ai-studio/
#
# Как получить:
#   1. Создайте сервисный аккаунт с ролью ai.languageModels.user
#   2. Создайте для него API-ключ
#   3. Скопируйте идентификатор каталога (folder_id)
#
YANDEX_CLOUD_API_KEY=
YANDEX_CLOUD_FOLDER_ID=

# OpenAI-совместимый базовый URL Yandex Cloud (менять обычно не нужно).
YANDEX_OPENAI_BASE_URL=https://llm.api.cloud.yandex.net/v1

# Модель эмбеддингов Yandex. Для документов: text-search-doc, для запросов: text-search-query.
# gbrain использует одну модель для индексации; оставьте text-search-doc.
# Формат URI подставляет YANDEX_CLOUD_FOLDER_ID автоматически в entrypoint.
YANDEX_EMBEDDING_MODEL=text-search-doc


# =============================================================================
# 3b. YANDEX SPEECHKIT — основной голосовой движок (STT + TTS)  (обязательно для голоса)
# =============================================================================
# Голосовые сообщения Telegram распознаются и озвучиваются через Yandex SpeechKit
# (подключён как command-провайдеры hermes — см. speechkit/*.sh). Использует те же
# ключи YANDEX_CLOUD_API_KEY / YANDEX_CLOUD_FOLDER_ID из блока 3.
# Роль ai.speechkit-stt.user / ai.speechkit-tts.user на сервисном аккаунте.
VOICE_ENABLED=true

# Язык распознавания речи (STT).
YANDEX_STT_LANG=ru-RU

# Голос синтеза (TTS). Примеры: alena, filipp, ermil, jane, omazh, zahar.
# Список: https://yandex.cloud/ru/docs/speechkit/tts/voices
YANDEX_TTS_VOICE=alena
YANDEX_TTS_LANG=ru-RU

# Автоматически отвечать голосом на голосовые сообщения.
VOICE_AUTO_TTS=true


# =============================================================================
# 4. GBRAIN — долговременная память  (память включена по умолчанию)
# =============================================================================
# Включить/выключить MCP-сервер памяти в hermes.
GBRAIN_ENABLED=true

# Каталог данных мозга (постоянный том amvera смонтирован в /opt/data — не меняйте на проде).
GBRAIN_HOME=/opt/data/gbrain

# Провайдер эмбеддингов: yandex (по умолчанию) | openai | zeroentropy
# При yandex используются ключи из блока 3 (через OpenAI-совместимый эндпоинт).
GBRAIN_EMBEDDING_PROVIDER=yandex

# --- Альтернативные провайдеры эмбеддингов (если GBRAIN_EMBEDDING_PROVIDER != yandex) ---
# ZEROENTROPY_API_KEY=ze-...      # дефолтный стек gbrain
# Для openai/совместимого — задаются автоматически из значений выше, либо вручную:
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1


# =============================================================================
# 5. GRAFIFY — граф знаний по коду  (MCP-инструмент, включён)
# =============================================================================
# MCP-сервер Grafify включён по умолчанию. В образ зашит граф этого репозитория
# (/opt/second_brain/graphify-out/graph.json) — бот может отвечать на вопросы о
# собственной структуре/конфигурации.
GRAFIFY_ENABLED=true

# Путь к графу. По умолчанию — зашитый граф репозитория. Чтобы отдать боту граф
# СВОЕГО проекта: постройте его (make graph в нужной папке), положите в том
# /opt/data/graphify-out/graph.json и укажите путь ниже.
GRAFIFY_GRAPH_PATH=/opt/second_brain/graphify-out/graph.json


# =============================================================================
# 5b. SECONDBRAIN — дневник-консультант (Obsidian-хранилище, персоны, feedback)
# =============================================================================
# MCP-сервер secondbrain реализует технический слой ТЗ.md (§9): приём дневника,
# персоны/дизамбигуация, детерминированный линт, feedback-журнал, прайсинг
# моделей. Нулевые внешние зависимости — только Node.js из базового образа.
SECONDBRAIN_ENABLED=true

# Корень Obsidian-хранилища. По умолчанию — подкаталог персистентного тома
# (${HERMES_HOME}/vault = /opt/data/vault на amvera). Не меняйте на проде.
OBSIDIAN_VAULT_PATH=/opt/data/vault

# Модели по умолчанию для «дешёвых» (L0–L3) и «дорогих» (L4–L5, прогноз/синтез)
# слоёв анализа — см. Promts/README.md. Пусто = дешёвые слои используют
# LLM_SUMMARY_MODEL (если задан), дорогие — текущую модель /model.
SECONDBRAIN_FAST_MODEL=
SECONDBRAIN_ADVISOR_MODEL=

# Vision-модель для разбора фото (люди, почерк) — см. ТЗ.md §4, §6.4.
# Пусто = используется текущая модель основного агента, если она умеет vision.
VISION_MODEL=


# =============================================================================
# 6. YANDEXGPT как LLM  (опционально — альтернатива/резерв для OpenRouter)
# =============================================================================
# Hermes умеет работать с любым OpenAI-совместимым эндпоинтом через base_url.
# Чтобы использовать YandexGPT вместо OpenRouter, задайте LLM_PROVIDER=yandex
# и раскомментируйте строки ниже. Модель — в формате gpt://<folder_id>/yandexgpt/latest
# (folder_id подставляется автоматически из YANDEX_CLOUD_FOLDER_ID).
# YANDEXGPT_MODEL=yandexgpt/latest


# =============================================================================
# 7. Разное
# =============================================================================
# Часовой пояс контейнера (для крона/напоминаний).
TZ=Europe/Moscow

# Не писать .pyc, буферизацию отключаем — оставьте как есть.
PYTHONUNBUFFERED=1
